# ============================================================
# GeneZ Configuration & Secrets
# ============================================================

# Google Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# NCBI Entrez Configuration
# NCBI requests an email address so they can contact you before blocking if overuse occurs
NCBI_EMAIL=student.bioinformatics@college.edu

# Optional NCBI API Key for higher rate limit (up to 10 queries/second instead of 3)
NCBI_API_KEY=

# Flask Configuration
FLASK_DEBUG=True
PORT=5000
HOST=127.0.0.1
SECRET_KEY=genez-secret-key-bioinformatics-project-2026

